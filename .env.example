# Пример окружения для docker-compose стека. Скопируйте в .env и правьте под себя:
#   cp .env.example .env
# .env в git НЕ коммитится (см. .gitignore) — держите реальные секреты только в нём.

# --- PostgreSQL (сервис postgres) ---
POSTGRES_USER=arena
POSTGRES_PASSWORD=arena
POSTGRES_DB=arena

# --- Сервер игры ---
# Ключ подписи токен-сессий. Пусто — сервер сгенерит эфемерный на запуск и предупредит
# (токены не переживут рестарт). Для персистентных сессий задайте свой:
#   openssl rand -hex 32
ARENA_AUTH_SECRET=
# Держать в занятой комнате столько игроков ботами-ИИ (0 — выключено).
ARENA_BOT_FILL=0
# Уровень логов: debug | info | warn | error
ARENA_LOG_LEVEL=info

# --- Grafana ---
# Пароль администратора Grafana (логин admin). Смените перед любым внешним доступом.
GF_SECURITY_ADMIN_PASSWORD=admin
